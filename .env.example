# O frontend usa o proxy do Vite para encaminhar /api para a Flask.
VITE_API_BASE_URL=/api

# Banco Supabase usado pela API Flask.
# Copie a URI PostgreSQL em Supabase > Connect > ORMs / Connection string.
# Nao compartilhe a senha nem versione este arquivo como .env.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
